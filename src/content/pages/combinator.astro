---
// src/pages/combinator.astro
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const pageTitle = "Peaceful Wolverine's family-friendly abuse combinator";
const pageDesc =
  "A modular insult system for The Isle. No profanity, 24.3 million combinations, deadpan delivery required.";
---

<Layout title={`${pageTitle} | ${config.site.title}`} description={pageDesc}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={pageTitle} pageDesc={pageDesc}>
    <div class="mb-5 flex flex-wrap gap-2">
      <div class="border-border bg-muted flex overflow-hidden rounded-full border" id="form" role="group" aria-label="Form">
        <button class="seg-btn" data-form="full" aria-pressed="true">Full</button>
        <button class="seg-btn" data-form="standard" aria-pressed="false">Standard</button>
        <button class="seg-btn" data-form="minimal" aria-pressed="false">Minimal</button>
      </div>
      <div class="border-border bg-muted flex overflow-hidden rounded-full border" id="deck" role="group" aria-label="Deck">
        <button class="seg-btn" data-deck="combinator" aria-pressed="true">Combinator</button>
        <button class="seg-btn" data-deck="killed" aria-pressed="false">They killed you</button>
        <button class="seg-btn" data-deck="kill" aria-pressed="false">You killed them</button>
        <button class="seg-btn" data-deck="ready" aria-pressed="false">Ready-made</button>
      </div>
      <div class="border-border bg-muted flex overflow-hidden rounded-full border" id="pack" role="group" aria-label="Pack mode">
        <button class="seg-btn" data-pack="off" aria-pressed="true">Solo</button>
        <button class="seg-btn" data-pack="on" aria-pressed="false">Pack</button>
      </div>
    </div>

    <div class="border-border bg-muted mb-4 flex min-h-40 items-center rounded-lg border px-6 py-7">
      <p id="line" class="m-0 text-xl leading-snug transition-opacity sm:text-2xl">Press generate.</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button id="go" class="bg-accent text-accent-foreground rounded-lg px-6 py-3 font-semibold">Generate</button>
      <button id="copy" class="border-border text-muted-foreground rounded-lg border px-4 py-3 text-sm">Copy</button>
    </div>
    <p class="text-muted-foreground mt-3 text-sm">Spacebar also generates. 24,300,000 full-form combinations.</p>

    <h2 class="text-muted-foreground mt-10 mb-2 text-sm tracking-widest uppercase">Recent</h2>
    <ol id="hist" class="border-border m-0 list-none border-t p-0"></ol>
  </Main>

  <Footer />
</Layout>

<style>
  .seg-btn {
    @apply text-muted-foreground px-3 py-2 text-sm;
  }
  .seg-btn[aria-pressed="true"] {
    @apply bg-accent text-accent-foreground;
  }
  #hist li {
    @apply border-border flex gap-3 border-b py-3;
  }
  #hist li span {
    @apply text-muted-foreground shrink-0 text-sm;
  }
</style>

<script>
const A=["Stand aside,","Away with you,","Be silent,","Come no closer,","I have no quarrel with you,","Behold —","You there,","Do not speak to me,","Explain yourself,","I had hoped never to meet","Kindly disperse,","A word, if I may address","Look at it. Just look at it —","I shall be brief,","There is no need for this,","Let the record show,","Under other circumstances I would ignore","I have travelled a long way to tell you this:","Someone ought to say it —","Not you. Never you,","Spare me,","I withdraw my greeting,","On reflection, no,","Step back into the fern,","I have consulted the herd, and we agree:","You have my attention, briefly,","I say this with the full weight of the river behind me:","History will not record this, but I shall:","Enough. Sit down,","I shall say it slowly, for the benefit of"];
const B=["damp","mildewed","curdled","thrice-boiled","turnip-scented","moth-eaten","lukewarm","pond-reared","draughty","faintly sticky","bog-adjacent","unrinsed","second-hand","under-salted","rain-spoiled","ditch-cured","fog-dwelling","twice-chewed","cupboard-smelling","wind-dried","puddle-born","half-thawed","mould-flecked","gravy-adjacent","sun-bleached","silt-flavoured","barn-damp","overboiled","unaired","recently rained upon"];
const C=["gormless","boggle-eyed","weak-chinned","custard-hearted","knock-kneed","dithering","wobbling","apologetic","under-baked","perpetually startled","stoop-shouldered","loose-jawed","flap-footed","chronically agreeable","unaccountably confident","visibly negotiable","blinking","officious","slack-mouthed","soft-spined","nervously cheerful","half-committed","drowsy","affronted","blustering","easily herded","sideways-walking","publicly damp","forward-leaning and backward-thinking","hesitant in all four legs"];
const D=[["bucket of pond water","buckets of pond water"],["sack of wet turnips","sacks of wet turnips"],["apology for a lizard","apologies for lizards"],["footnote","footnotes"],["blancmange","blancmanges"],["bag of elbows","bags of elbows"],["hedge","hedges"],["wheelbarrow","wheelbarrows"],["disappointment with legs","disappointments with legs"],["rumour of a dinosaur","rumours of dinosaurs"],["draught excluder","draught excluders"],["wet hymn book","wet hymn books"],["committee of one","committees of one"],["trifle left out overnight","trifles left out overnight"],["misfiled specimen","misfiled specimens"],["clerical error with teeth","clerical errors with teeth"],["hand-me-down carnivore","hand-me-down carnivores"],["placeholder","placeholders"],["sock of regrets","socks of regrets"],["speed bump","speed bumps"],["bowl of lukewarm consequences","bowls of lukewarm consequences"],["holotype of nothing","holotypes of nothing"],["long sigh in a body","long sighs in bodies"],["gravy boat","gravy boats"],["decorative shrub","decorative shrubs"],["bag of damp receipts","bags of damp receipts"],["mistake with a pulse","mistakes with a pulse"],["provisional animal","provisional animals"],["understudy","understudies"],["cautionary tale with a tail","cautionary tales with tails"]];
const E=["Your mother knits with soup.","You were raised entirely by a fence.","Your family crest is a shrug.","I have seen more menace in a scone.","Even the ferns pity you.","You smell faintly of Tuesday.","Your father was a wardrobe and he was ashamed of you.","You were weaned on regret and lukewarm gravy.","Somewhere, a bog is missing its contents.","You have the bearing of a dropped trifle.","The river has opinions about you.","I have been frightened by a gate.","Your pack tolerates you at a distance.","Nobody named you. You were assigned.","You will be a cautionary paragraph.","The ferns were here first and they have standards.","You are the reason the bushes lock up at night.","I shall think of you whenever something is almost finished.","Your ancestors crossed a land bridge for this.","You were the compromise.","The grass does not part for you.","I have met bolder weather.","Your silhouette is an apology.","You will not be mentioned in the patch notes.","You were last in the water and it showed.","Even your footprints look uncertain.","You are what happens when a herd stops counting.","You will be survived by nothing in particular.","I have seen you flinch at scenery.","They gave you teeth as a courtesy."];
const KILLED=["Congratulations. You have peaked.","Enjoy it. Nobody else will hear about it.","That was the highlight of your week and we both know it.","You have won an argument with a herbivore. Tell your family.","I hope it was worth the walk.","I shall remember this. Briefly.","Ah. So that is what you are for.","You may put it on the stone.","A triumph, by your standards, which I have now seen.","You have killed a creature whose chief defence is leaving. Well done.","Add it to the pile. The pile is small.","I was going to log off anyway.","Somewhere a server is quietly updating your reputation. Downward.","You will tell this story. People will leave.","That is the most decisive thing you will do today."];
const KILL=["No, no. Stay down. You are better at it.","That was less a fight than a formality.","I am told there is a beginner's server.","You may have that one back if you like. I am not hungry.","Do not take it personally. Take it geographically. Leave.","I shall not be eating that. I have standards and you have gristle.","You came a long way to lie down.","I would say well fought, but the record is public.","Rest. You have earned the ground.","You have been filed.","That is the quietest you have been all evening.","Your pack is watching. I would start explaining now.","I shall leave the body as a notice.","You arrived with ambition and are leaving with gravity.","A short career, handsomely concluded."];
const READY=["I would call you a coward, but cowards commit to something.","You are the reason the herd looks tired.","I have been threatened by weather with more conviction.","Your ancestors climbed out of the swamp and you have clearly gone back in.","You fight like a man being handed a leaflet.","I have had more trouble from a low branch.","Go and be beige somewhere else.","You have the aura of a spare chair.","If you were a sound, you would be a cough in another room.","I have met puddles with firmer convictions.","You are the pause before someone changes the subject.","There is a hedge somewhere doing your job better.","I would describe you, but I would need to see you first, and I have.","You move like an apology arriving late.","I have seen bolder behaviour from scenery.","You are what the patch notes meant by minor adjustments.","There is a fern behind you with more presence.","You have the confidence of someone who has not checked.","I would flee, but it seems unnecessary.","You are a draught with opinions."];

  function init() {
    const lineEl = document.getElementById("line");
    const histEl = document.getElementById("hist");
    const goBtn = document.getElementById("go");
    if (!lineEl || !histEl || !goBtn) return;

    let form = "full";
    let deck = "combinator";
    let pack = false;
    const last = {};
    const hist = [];

    function pick(arr, key) {
      if (arr.length < 2) return arr[0];
      let i = 0, guard = 0;
      do {
        i = Math.floor(Math.random() * arr.length);
        guard++;
      } while (i === last[key] && guard < 12);
      last[key] = i;
      return arr[i];
    }

    function build() {
      if (deck === "killed") return pick(KILLED, "killed");
      if (deck === "kill") return pick(KILL, "kill");
      if (deck === "ready") return pick(READY, "ready");
      const d = pick(D, "D");
      const noun = pack ? d[1] : d[0];
      if (form === "minimal")
        return (pack ? "The lot of you. " : "") + noun.charAt(0).toUpperCase() + noun.slice(1) + ".";
      const a = pick(A, "A");
      const b = pick(B, "B");
      const subject = pack ? "the lot of you" : "you";
      const article = a === "I had hoped never to meet" ? "a " : subject + " ";
      if (form === "standard") return `${a} ${article}${b} ${noun}.`;
      const c = pick(C, "C");
      const e = pick(E, "E");
      return `${a} ${article}${b}, ${c} ${noun}. ${e}`;
    }

    function generate() {
      const t = build();
      lineEl.style.opacity = "0";
      setTimeout(() => {
        lineEl.textContent = t;
        lineEl.style.opacity = "1";
      }, 110);
      hist.unshift(t);
      if (hist.length > 8) hist.pop();
      histEl.innerHTML = hist
        .map((h, i) => `<li><span>${String(i + 1).padStart(2, "0")}</span>${h.replace(/&/g, "&amp;").replace(/</g, "&lt;")}</li>`)
        .join("");
    }

    goBtn.addEventListener("click", generate);

    const copyBtn = document.getElementById("copy");
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(lineEl.textContent ?? "");
        copyBtn.textContent = "Copied";
      } catch {
        copyBtn.textContent = "Select it";
      }
      setTimeout(() => (copyBtn.textContent = "Copy"), 1200);
    });

    function wireSeg(id, fn) {
      document.getElementById(id)?.addEventListener("click", ev => {
        const b = ev.target.closest("button");
        if (!b) return;
        ev.currentTarget
          .querySelectorAll("button")
          .forEach(x => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
        fn(b);
        generate();
      });
    }
    wireSeg("form", b => (form = b.dataset.form));
    wireSeg("deck", b => (deck = b.dataset.deck));
    wireSeg("pack", b => (pack = b.dataset.pack === "on"));

    document.addEventListener("keydown", e => {
      const tag = document.activeElement?.tagName ?? "";
      if (e.code === "Space" && !/^(INPUT|TEXTAREA|BUTTON)$/.test(tag)) {
        e.preventDefault();
        generate();
      }
    });

    generate();
  }

  document.addEventListener("astro:page-load", init);
</script>
